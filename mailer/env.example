# Sao chép thành mailer/.env rồi điền giá trị thật. File .env không được commit.
# Biến môi trường thật (nếu có) được ưu tiên hơn file này.

# Địa chỉ project Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (service-role) của Supabase. CHỈ để ở máy chạy mailer, tuyệt đối không đưa vào frontend.
SUPABASE_SERVICE_KEY=your-supabase-secret-key

# Địa chỉ website, dùng dựng liên kết ${SITE_URL}/chien-dich?campaign=<id>
SITE_URL=https://hanoixanh.example.com

# SMTP (Gmail: smtp.gmail.com, cổng 587, starttls, dùng "Mật khẩu ứng dụng")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=hanoixanhh@gmail.com
SMTP_PASSWORD=your-app-password

# Người gửi và địa chỉ nhận phản hồi (tùy chọn)
MAIL_FROM=Hà Nội Xanh <hanoixanhh@gmail.com>
MAIL_REPLY_TO=

# Số giây giữa hai lần kiểm tra, số lần thử tối đa cho mỗi lượt đăng ký
POLL_SECONDS=30
MAX_ATTEMPTS=5

# Múi giờ hiển thị thời gian trong thư
MAILER_TIMEZONE=Asia/Ho_Chi_Minh

# Thông báo hàng loạt cho người đăng ký chiến dịch (xem README, mục "Thông báo hàng loạt")
# Đặt false để tắt riêng phần thông báo (thư xác nhận đăng ký vẫn chạy)
ANNOUNCEMENTS_ENABLED=true
# Số thư thông báo tối đa mỗi phút (mỗi thư cách nhau 60/số này giây) để Gmail không khóa tài khoản
ANNOUNCE_PER_MINUTE=20
# Tổng số thư gửi mỗi ngày (xác nhận + thông báo + thư thử), tính theo MAILER_TIMEZONE.
# Gmail thường giới hạn khoảng 500 thư/ngày; 400 là mức an toàn. Đạt hạn mức thì thông báo dừng tới hết ngày.
MAILER_DAILY_LIMIT=400
