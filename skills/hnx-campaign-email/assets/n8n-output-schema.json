{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "email_type",
    "to",
    "subject",
    "preheader",
    "html",
    "text",
    "missing_fields",
    "warnings"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["send", "review", "skip"]
    },
    "email_type": {
      "type": "string",
      "enum": [
        "registration_confirmation",
        "reminder",
        "change_notice",
        "cancellation_notice",
        "post_event_followup"
      ]
    },
    "to": { "type": "string", "maxLength": 320 },
    "subject": { "type": "string", "maxLength": 120 },
    "preheader": { "type": "string", "maxLength": 180 },
    "html": { "type": "string", "maxLength": 12000 },
    "text": { "type": "string", "maxLength": 8000 },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
