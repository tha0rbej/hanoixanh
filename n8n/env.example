# Sao chép thành n8n/.env rồi điền giá trị thật:  cp env.example .env
# File .env đã nằm trong .gitignore (mẫu `.env*`). Không commit, không dán key vào chat/ảnh chụp màn hình.
# Mọi giá trị dưới đây là MẪU, không phải key thật. Không để dấu cách quanh dấu "=" và không có dấu nháy.

# --- Bắt buộc ---------------------------------------------------------------

# Khóa mã hóa credential của n8n. Tạo một lần: openssl rand -hex 32
# Mất hoặc đổi khóa này thì mọi credential đã lưu trong n8n không giải mã được nữa. Hãy sao lưu nó.
N8N_ENCRYPTION_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu

# Supabase Dashboard -> Project Settings -> API -> Project URL. Không có dấu / ở cuối.
HNX_SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> Secret key (dạng sb_secret_...).
# Chỉ nằm ở n8n, không bao giờ đưa vào frontend. Dùng cho 2 lệnh gọi RPC và kiểm tra JWT/quyền admin trong main workflow.
HNX_SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Chỉ dùng khi project Supabase cũ chưa có Secret key, hoặc khi Secret key bị từ chối: key `service_role` (legacy, dạng JWT eyJ...).
# HNX_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL công khai của website (không có dấu / ở cuối), dùng để ghi published_url vào publication_jobs.
HNX_PUBLIC_SITE_URL=https://hanoixanh.example.com

# --- Model của Agent (OpenAI) -------------------------------------------------

# Model cho node "OpenAI Chat Model". Giá tham khảo gpt-6-luna: $0.10 vào / $0.50 ra mỗi 1 triệu token.
# Có thể đổi sang gpt-6-sol hoặc gpt-4.1. Với model không có suy luận như gpt-4.1, bỏ comment dòng
# OPENAI_REASONING_EFFORT= ở dưới và để giá trị rỗng (khi đó workflow không gửi tham số reasoning).
# API key OpenAI KHÔNG đặt ở đây: tạo credential "HNX OpenAI" trong n8n (platform.openai.com -> API keys).
OPENAI_MODEL=gpt-6-luna
# Mức suy luận (reasoning.effort). Token suy luận tính tiền như token đầu ra. Không khai báo = low.
# Giá trị hợp lệ tùy model, ví dụ none/low/medium/high. Rỗng = không gửi tham số.
# OPENAI_REASONING_EFFORT=low

# --- Chỉ cần khi đăng Threads -----------------------------------------------

# ID tài khoản Threads của tổ chức. Lấy bằng: GET https://graph.threads.com/v1.0/me?access_token=<token>
# (token là access token dài hạn của Threads, được lưu trong credential "HNX Threads Publisher", không để ở đây).
THREADS_USER_ID=1234567890

# --- Tùy chọn ---------------------------------------------------------------

# Khi có tunnel/domain: đặt URL công khai của n8n (có dấu / ở cuối) rồi chạy lại `docker compose up -d`.
# Production URL của webhook sẽ đổi theo. Để trống/xóa dòng này khi chạy local.
# N8N_PUBLIC_URL=https://n8n.example.com/

# Đặt true khi n8n nằm sau HTTPS (tunnel/reverse proxy). Local qua http thì để false.
# N8N_SECURE_COOKIE=true
